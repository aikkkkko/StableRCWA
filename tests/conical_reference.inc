// tests/conical_reference.inc —— 圆锥入射的参照表（由脚本生成，请勿手改；生成脚本不在本仓库里，生成后只改过算例 8 的名称）
//
// 数据：Python 参照求解器（逐级次衍射面基，Li 逆规则）给出的十个算例，每个算例列出 −M … +M 全部级次的
// 2×2 Jones 矩阵，倏逝级一并列出，17 位有效数字。长度单位 µm，约定见 include/stablercwa/rcwa1d_conical.hpp 文件头。
//   · jr[8]、jt[8]：反射、透射 Jones 矩阵，依次是 ss、sp、ps、pp 的（实部, 虚部），共 8 个数；
//     ab 表示输出 a ← 输入 b（行是输出，列是输入；下标 s、p 是物理的 s、p 分量，入射波是零级、单位电场幅值）；
//   · 每个算例一张按级次从小到大排列的表 kConicalRef<编号>，kConicalRefCases 汇总十张表；
//   · conical_ref_stack(id) 按同一张结构表建出 rcwa::Stack，id 不在 1…10 里抛 std::invalid_argument。
// 用法：先包含 stablercwa/rcwa1d.hpp，再包含本文件。本文件不依赖 examples/。

struct ConicalRefOrder { int m; double jr[8]; double jt[8]; };
struct ConicalRefCase {
    int id;
    const char* name;
    double wavelength, theta_deg, phi_deg;
    int M;
    const ConicalRefOrder* orders;
    int count;
};

