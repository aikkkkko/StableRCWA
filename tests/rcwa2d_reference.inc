// tests/rcwa2d_reference.inc —— 二维（交叉光栅）RCWA 的 C++ 参照表（由 gui/validation/generate_field_reference_2d.py 生成，请勿手改）
//
// 数据来源：权威 Python 求解器 gui/2drcwa/rcwa2d.py 的冻结输出 gui/validation/field_reference_2d/reference_2d_v1.npz。
//   源 NPZ 的 SHA-256 = 0d4837ae4c084a95d6ebe5879b42196aafd181d006aa2de19267fe65b03e1a61
//   JSON（输入、容差、源码哈希）：gui/validation/field_reference_2d/reference_2d_v1.json；校验：gui/validation/test_field_contract_2d.py。
// 长度单位 µm，时间因子 exp(−iωt)，约定见 include/stablercwa/rcwa2d_types.hpp 与 gui/validation/field_reference_2d/CONTRACT_2D.md。
// 数字用最短可往返的十进制写出（读回得到完全相同的 double），复数写成（实部, 虚部）。
//
// 内容（只含 N = (2M1+1)(2M2+1) ≤ 169 的算例；N≈600 的大算例与全部切面 / 相位数组只在 NPZ 里）：
//   · Rcwa2dRefCase：几何（经 rcwa2d_ref_stack(id) 建出 Stack2D）、λ、θ、φ（度）、M1、M2、Jones [Es, Ep]（显式，不再归一）、
//     因式分解（0 = Li，1 = Laurent）、远场与近场的容差（|a−b| ≤ atol + rtol·|b|，逐复数）；
//   · Rcwa2dRefOrder：Result2D 的逐级数组，与 Python 同序（m 在外层、n 在内层；下标 = harmonic_index_2d），
//     Kx、Ky、kzI、kzII 以 k0 为单位；Ex_r…Tp 是入射 Jones 的响应（入射电场矢量范数 = Jones 范数 = 1）；
//   · Rcwa2dRefDepth：若干 z 处六个分量的谐波列（Ex, Ey, Ez, Hx, Hy, Hz；H 是 Z0·H，入射 |E| = 1、|Z0H| = nI）；
//     columns[i].c[分量][0/1] = 实部 / 虚部，i = 谐波下标。z 的选取避开层界面 ±1e-12 的归属带（紧靠界面取 ±1e-6）；
//   · Rcwa2dRefOperators：最小几个结构层算例的 Eps、Cx、Cy（N×N，按行存放：元素 (i, j) 的实、虚部在 [(i*N + j)*2 + 0/1]）；
//   · status = 1（Rayleigh 异常）的算例没有数值，只有期望的失败区域（"入射区" / "出射区" / "第j层"）与 (m, n) 列表，
//     与 rcwa2d.py 的 RayleighAnomalyError 消息一致。
// 用法：先包含 stablercwa/rcwa2d_types.hpp（或 rcwa2d.hpp），再包含本文件；本文件不依赖其他测试头文件。

struct Rcwa2dRefOrder {
    int m, n;
    double Kx, Ky;
    double kzI[2], kzII[2];
    double Ex_r[2], Ey_r[2], Ez_r[2], Ex_t[2], Ey_t[2], Ez_t[2];
    double Rs[2], Rp[2], Ts[2], Tp[2];
    double DEr, DEt;
    int prop_r, prop_t;
};
struct Rcwa2dRefColumn { double c[6][2]; };
struct Rcwa2dRefDepth { double z; const Rcwa2dRefColumn* columns; };
struct Rcwa2dRefOperators { int layer; int N; const double* eps; const double* cx; const double* cy; };
struct Rcwa2dRefCase {
    int id;
    const char* name;
    double wavelength, theta_deg, phi_deg;
    int M1, M2;
    double jones[4];                       // Es 实部, Es 虚部, Ep 实部, Ep 虚部
    int laurent;                           // 0 = Li（生产默认），1 = Laurent
    double far_atol, far_rtol, near_atol, near_rtol;
    int status;                            // 0 = 成功，1 = RayleighAnomaly（此时只有 failure_*）
    const char* failure_region;
    int failure_count;
    const int (*failure_orders)[2];
    const Rcwa2dRefOrder* orders;
    int count;                             // N
    const Rcwa2dRefDepth* depths;
    int depth_count;
    const Rcwa2dRefOperators* operators;
    int operator_count;
};

