def mk_layer(L):
    if "n" in L:
        return R.Layer2D(L["d"], n=L["n"], name=L["name"])
    return R.Layer2D(L["d"], y_edges=L["ye"], x_profiles=[(np.array(xe), np.array(nv)) for xe, nv in L["rows"]],
                     name=L["name"])


def cstr(c):
    return "%.17g, %.17g" % (c.real, c.imag)


def arr_c(name, v):
    v = np.asarray(v, complex).ravel()
    body = ",\n    ".join(", ".join("%.17g, %.17g" % (z.real, z.imag) for z in v[i:i + 3]) for i in range(0, len(v), 3))
    return "static const double %s[] = {\n    %s};\n" % (name, body)


def arr_r(name, v):
    v = np.asarray(v, float).ravel()
    body = ",\n    ".join(", ".join("%.17g" % x for x in v[i:i + 6]) for i in range(0, len(v), 6))
    return "static const double %s[] = {\n    %s};\n" % (name, body)


def arr_i(name, v):
    return "static const int %s[] = {%s};\n" % (name, ", ".join(str(int(x)) for x in v))


